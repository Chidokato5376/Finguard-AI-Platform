# Data (không commit dữ liệu thô/đã xử lý — chỉ commit schema & script)
# Dấu * sau processed để bắt cả các thư mục lát dữ liệu khác, vd.
# data/processed_3m/ (lát 3 triệu dòng, xem docs/augmentation.md).
data/raw/*
data/processed*/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Dataset tổng hợp có phiên bản (src/augmentation) — chỉ commit manifest để
# truy vết, không commit các dòng dữ liệu đã sinh (có thể sinh lại từ manifest)
data/synthetic/*
!data/synthetic/**/manifest.json
!data/synthetic/**/specs.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Models / checkpoints
*.pt
*.pth
*.ckpt
models/

# Environment
.env

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Log chạy dài (tiền xử lý / huấn luyện)
logs/
# Điểm từng biến thể R1 (vài trăm MB, tái tạo được bằng scripts/run_r1.sh) và dấu đã chạy xong.
reports/r1/*/scores/
reports/r0/*.done
reports/leaderboard/*/scores/
reports/r[0-9]*/*.done
transfer/

# Điểm thô của từng mô hình (hàng chục–hàng trăm MB .npy): dựng lại bằng scripts/leaderboard.py.
reports/**/scores/
# Gói của prototype web PHẢI được commit (máy chủ triển khai đọc trực tiếp): bỏ loại trừ "models/".
!prototype/bundle/models/
!prototype/bundle/models/*.pt
