# .gitignore CẤP GỐC — chỉ chặn rác chung ở gốc repository.
# Mỗi dự án con có .gitignore RIÊNG với quy tắc phù hợp của nó:
#   - Finguard/.gitignore       : loại data/raw, data/processed, models (dự án chính)
#   - Finguard-Demo/.gitignore  : GIỮ data/processed (demo cần dữ liệu để hiển thị)
# Git áp dụng .gitignore theo phạm vi thư mục chứa nó nên hai bộ quy tắc trên
# không ảnh hưởng lẫn nhau — KHÔNG thêm quy tắc data/ hay models/ vào file này.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Environment
.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
